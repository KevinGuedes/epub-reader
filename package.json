{
  "name": "epub-reader",
  "productName": "EPUB Reader",
  "version": "0.1.0",
  "description": "Offline EPUB reader for Linux with one-chapter-at-a-time scrolling, reading customization and saved progress",
  "main": "./out/main/index.js",
  "desktopName": "epub-reader.desktop",
  "author": "Kevin",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "epub2": "^3.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "epubjs": "^0.3.93",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "zustand": "^5.1.0"
  }
}
